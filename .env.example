# Copy to .env.local for settings that should not be committed.
#
# Use the mock API instead of OutSystems (dev only; ignored in production builds).
NEXT_PUBLIC_USE_MOCK_API=false
#
# Server-only. Used by the /api proxy. Never prefix with NEXT_PUBLIC_.
OUTSYSTEMS_BASE_URL=https://smuedu-dev.outsystemsenterprise.com

# P6 server-only: team key for protected Sender/A8 lookups and native test harness.
OUTSYSTEMS_INTERNAL_SERVICE_KEY=
# Default off. Enable only for an authorized, ready Product 205 demo environment.
# Confirmation can approve/fund a loan; monthly collection remains disabled.
P6_ADVANCE_ACCEPTANCE_ENABLED=false
# Exact browser origin when Next's internal URL differs, e.g. http://localhost:3000.
# Server-only; never derived from browser body or forwarded-host headers.
P6_FRONTEND_ORIGIN=
