{
  "name": "dbea-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.3",
  "description": "RemitEase (IS444 Team 3) - Next.js frontend for the OutSystems backend",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test:env": "node --test tests/bun-env.test.mjs",
    "test:p5": "node --test tests/p5-state.test.mjs",
    "test:p5:bank-history": "node --test tests/p5-bank-history-checks.test.mjs",
    "test:p5:bank-history:backend": "node --env-file=.env.local scripts/run-p5-bank-history-checks.mjs",
    "test:p6": "node --test tests/p6-gateway.test.mjs",
    "test:p6:repayments": "node --test tests/p6-repayment-harness.test.mjs",
    "test:p6:repayments:backend": "node --env-file=.env.local scripts/run-p6-repayment-harness.mjs",
    "test:p6:e2e": "playwright test --project=smoke",
    "test:p6:live": "playwright test --project=live-confirmation",
    "rabbitmq:up": "docker compose -f infra/rabbitmq/docker-compose.yml up -d",
    "rabbitmq:down": "docker compose -f infra/rabbitmq/docker-compose.yml down",
    "rabbitmq:status": "docker compose -f infra/rabbitmq/docker-compose.yml ps",
    "rabbitmq:url": "node infra/rabbitmq/tunnel-url.mjs"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4"
  }
}
