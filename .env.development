# Loaded by `npm run dev` only. No secrets in this file.
#
# true  = use the built-in mock API (app/api/mock) so the UI works without OutSystems.
# false = call the real backend through P2's /api proxy (once it exists).
# To change it just for your machine, put the line in .env.development.local instead.
NEXT_PUBLIC_USE_MOCK_API=true
